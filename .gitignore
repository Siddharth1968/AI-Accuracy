# Python virtual environments & caches
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# Trained model checkpoint without confirmed public redistribution rights
model/clean_btn_vit_phase12.pt
model/*.pt
model/*.pth

# Local academic dataset library (non-redistributable / restricted datasets)
